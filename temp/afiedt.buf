SELECT mm.MENU_ID,
       mm.MENU_OPTION_DESC,
       mm.MENU_BUTTON_1,
       mm.MENU_ACTION,
       mm.MENU_SEQ_NO,
       LEVEL AS menu_level
FROM   MENU_USER mu
JOIN   MENU_USER_MENUS umm
       ON mu.USER_GROUP_ID = umm.UM_GROUP_ID
JOIN   MENU_MENUS mm
       ON mm.MENU_ID = umm.UM_MENU_ID
WHERE  mu.USER_ID = 'ORION'
  AND  (mm.MENU_BUTTON_1 LIKE '/reports/%' OR mm.MENU_ACTION_TYPE = 'R')
START WITH mm.MENU_PARENT_ID = '*'
CONNECT BY PRIOR mm.MENU_ID = mm.MENU_PARENT_ID
           AND PRIOR mu.USER_ID = mu.USER_ID
ORDER SIBLINGS BY mm.MENU_SEQ_NO
/
